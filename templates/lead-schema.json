{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead",
  "description": "Minimum fields for a central lead table. One row per person per enquiry. No sensitive personal data at lead stage.",
  "type": "object",
  "required": ["lead_id", "created_at", "source", "brand", "service", "status", "owner"],
  "properties": {
    "lead_id": { "type": "string", "description": "Stable internal ID" },
    "created_at": { "type": "string", "format": "date-time" },
    "full_name": { "type": "string" },
    "email": { "type": "string", "format": "email", "description": "Lower-cased before matching" },
    "phone_e164": { "type": "string", "pattern": "^\\+[1-9]\\d{6,14}$", "description": "Normalised, e.g. +447700900123" },
    "language": { "type": "string", "enum": ["en", "tr", "ar", "fr", "other"] },
    "source": { "type": "string", "enum": ["web_form", "meta_lead_ad", "whatsapp", "email", "phone", "referral", "event", "other"] },
    "campaign": { "type": "string", "description": "UTM or ad campaign name" },
    "brand": { "type": "string", "description": "Which brand or business line the enquiry is for" },
    "service": { "type": "string", "description": "Service requested, from a fixed list" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "score_reasons": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "qualified", "booked", "paid_consultation", "proposal", "won", "lost", "nurture"]
    },
    "owner": { "type": "string", "description": "Named person responsible" },
    "first_response_at": { "type": "string", "format": "date-time" },
    "booked_at": { "type": "string", "format": "date-time" },
    "paid_at": { "type": "string", "format": "date-time" },
    "next_action": { "type": "string" },
    "next_action_due": { "type": "string", "format": "date" },
    "lost_reason": { "type": "string" },
    "marketing_consent": { "type": "boolean", "default": false },
    "opted_out": { "type": "boolean", "default": false }
  }
}
